# Kopieer dit bestand naar `.env` en vul je eigen sleutels in.
# `.env` staat in .gitignore en gaat NOOIT naar git.

# --- GoHighLevel (Fase 1) ---
# Private Integration token uit GHL (Settings > Private Integrations)
GHL_TOKEN=
# Jouw sub-account / locatie ID
GHL_LOCATION_ID=EIwIeeqIf6jyjmhmEpZW
# API-versie header (laat standaard staan tenzij GHL iets anders vraagt)
GHL_API_VERSION=2021-07-28

# --- Brein / LLM (Fase 2) ---
# Maak een NIEUWE key aan op console.anthropic.com (plak 'm nergens in chat!)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stem (Fase 3, optioneel) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Fase 4, optioneel ---
# Map waar Jarvis bestanden mag lezen/schrijven (nooit je hele computer)
WORKDIR=
